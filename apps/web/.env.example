# Supabase — new key format (sb_publishable_… / sb_secret_…) OR legacy keys.
# Set the URL and ONE key from each pair.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Browser key (public): new publishable key, or legacy anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxx
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...   # legacy alternative

# Server key (secret — set only in the host, never commit): new secret key, or legacy service_role.
SUPABASE_SECRET_KEY=sb_secret_xxxxx
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...        # legacy alternative

# Razorpay (test keys for development)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
